<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Quadcopter-style drone - a single rigid "chassis" body flown with
         force commands by the DroneForceController plugin (drone_plugins).

         Competition robot design rules
           - collision box 0.30 x 0.30 x 0.08 m (min 0.15 x 0.20 x 0.05, max 0.5 x 0.5 x 0.5)
           - total mass 20.0 kg, the maximum allowed (0.5 - 20 kg), every link >= 0.01 kg.
             Heavy on purpose - the wind force does not depend on mass, so it
             barely accelerates a 20 kg drone. The controllers scale with mass.
           - wind enabled on the chassis link (flying robot)
           - camera Gaussian noise stddev >= 0.007 -->

    <xacro:property name="chassis_length" value="0.30" />
    <xacro:property name="chassis_width" value="0.30" />
    <xacro:property name="chassis_height" value="0.08" />
    <!-- 19.93 + seven 0.01 kg sensor links = 20.0 kg -->
    <xacro:property name="chassis_mass" value="19.93" />

    <xacro:property name="rotor_radius" value="0.06" />
    <xacro:property name="rotor_offset" value="0.105" />

    <xacro:property name="camera_side_length" value="0.03" />
    <!-- rad, positive tilts the camera down. 0.6 rad (~34 deg) so the front camera
         sees the low clue banners (~6 cm above the ground) from a 0.4 m hover -->
    <xacro:property name="camera_pitch" value="0.6" />
    <!-- rad, the side cameras tilt down less - clues seen from the walls are 0.7 - 2 m away -->
    <xacro:property name="side_camera_pitch" value="0.25" />

    <xacro:include filename="$(find my_robot_pkg)/urdf/drone_gazebo.xacro" />

    <material name="dark_gray">
        <color rgba="0.2 0.2 0.2 1" />
    </material>

    <material name="orange">
        <color rgba="1.0 0.5 0.0 1" />
    </material>

    <material name="gray">
        <color rgba="0.7 0.7 0.7 1" />
    </material>

    <xacro:macro name="rotor_visual" params="x y">
        <visual>
            <origin xyz="${x} ${y} ${chassis_height - 0.01}" rpy="0 0 0" />
            <geometry>
                <cylinder radius="${rotor_radius}" length="0.005" />
            </geometry>
            <material name="orange" />
        </visual>
    </xacro:macro>

    <link name="chassis">
        <xacro:box_inertia m="${chassis_mass}" x="${chassis_length}" y="${chassis_width}"
        z="${chassis_height}" o_xyz="0 0 ${chassis_height / 2.0}" o_rpy="0 0 0" />

        <collision>
            <origin xyz="0 0 ${chassis_height / 2.0}" rpy="0 0 0" />
            <geometry>
                <box size="${chassis_length} ${chassis_width} ${chassis_height}" />
            </geometry>
        </collision>

        <!-- Central body -->
        <visual>
            <origin xyz="0 0 ${chassis_height / 2.0}" rpy="0 0 0" />
            <geometry>
                <box size="0.12 0.10 0.05" />
            </geometry>
            <material name="dark_gray" />
        </visual>

        <!-- Arms (X configuration) -->
        <visual>
            <origin xyz="0 0 ${chassis_height / 2.0}" rpy="0 0 ${pi / 4.0}" />
            <geometry>
                <box size="${2.0 * rotor_offset * sqrt(2.0)} 0.02 0.015" />
            </geometry>
            <material name="dark_gray" />
        </visual>
        <visual>
            <origin xyz="0 0 ${chassis_height / 2.0}" rpy="0 0 ${-pi / 4.0}" />
            <geometry>
                <box size="${2.0 * rotor_offset * sqrt(2.0)} 0.02 0.015" />
            </geometry>
            <material name="dark_gray" />
        </visual>

        <!-- Rotors -->
        <xacro:rotor_visual x="${rotor_offset}" y="${rotor_offset}" />
        <xacro:rotor_visual x="${rotor_offset}" y="${-rotor_offset}" />
        <xacro:rotor_visual x="${-rotor_offset}" y="${rotor_offset}" />
        <xacro:rotor_visual x="${-rotor_offset}" y="${-rotor_offset}" />
    </link>

    <link name="camera_link">
        <xacro:box_inertia m="0.01" x="${camera_side_length}" y="${camera_side_length}"
        z="${camera_side_length}" o_xyz="${camera_side_length / 2} 0 0" o_rpy="0 0 0" />

        <visual>
            <geometry>
                <box size="${camera_side_length} ${camera_side_length} ${camera_side_length}" />
            </geometry>
            <origin xyz="${camera_side_length / 2} 0 0" rpy="0 0 0" />
            <material name="gray" />
        </visual>
    </link>

    <joint name="chassis_camera_joint" type="fixed">
        <parent link="chassis" />
        <child link="camera_link" />
        <origin xyz="${chassis_length / 2.0} 0 ${chassis_height / 2.0}" rpy="0 ${camera_pitch} 0" />
    </joint>

    <!-- Downward-facing navigation camera under the centre of the chassis -->
    <link name="down_camera_link">
        <xacro:box_inertia m="0.01" x="${camera_side_length}" y="${camera_side_length}"
        z="${camera_side_length}" o_xyz="0 0 0" o_rpy="0 0 0" />

        <visual>
            <geometry>
                <box size="${camera_side_length} ${camera_side_length} ${camera_side_length}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="gray" />
        </visual>
    </link>

    <!-- Pitch +90 deg so the camera's optical (+x) axis points straight down -->
    <joint name="chassis_down_camera_joint" type="fixed">
        <parent link="chassis" />
        <child link="down_camera_link" />
        <origin xyz="0 0 0.01" rpy="0 ${pi / 2.0} 0" />
    </joint>

    <!-- Downward range sensor (tiny depth camera) under the chassis, behind the
         down camera so the camera housing isn't in its view -->
    <link name="down_range_link">
        <xacro:box_inertia m="0.01" x="0.02" y="0.02" z="0.01" o_xyz="0 0 0" o_rpy="0 0 0" />

        <!-- Visual sits just above the sensor (link -x is up) - the depth camera
             sees visuals, so a housing around the sensor would block its view -->
        <visual>
            <geometry>
                <box size="0.01 0.02 0.02" />
            </geometry>
            <origin xyz="-0.006 0 0" rpy="0 0 0" />
            <material name="orange" />
        </visual>
    </link>

    <!-- Pitch +90 deg so the sensor's +x axis points straight down. At the
         chassis origin height, so the range is the drone's height above the ground -->
    <joint name="chassis_down_range_joint" type="fixed">
        <parent link="chassis" />
        <child link="down_range_link" />
        <origin xyz="-0.06 0 0" rpy="0 ${pi / 2.0} 0" />
    </joint>

    <!-- Side cameras (clues beside the drone), at the left and right edges.
         Same housing as the front camera, rotated to look sideways. -->
    <xacro:macro name="side_camera" params="side y yaw">
        <link name="${side}_camera_link">
            <xacro:box_inertia m="0.01" x="${camera_side_length}" y="${camera_side_length}"
            z="${camera_side_length}" o_xyz="${camera_side_length / 2} 0 0" o_rpy="0 0 0" />

            <visual>
                <geometry>
                    <box size="${camera_side_length} ${camera_side_length} ${camera_side_length}" />
                </geometry>
                <origin xyz="${camera_side_length / 2} 0 0" rpy="0 0 0" />
                <material name="gray" />
            </visual>
        </link>

        <joint name="chassis_${side}_camera_joint" type="fixed">
            <parent link="chassis" />
            <child link="${side}_camera_link" />
            <origin xyz="0 ${y} ${chassis_height / 2.0}" rpy="0 ${side_camera_pitch} ${yaw}" />
        </joint>
    </xacro:macro>

    <xacro:side_camera side="left" y="${chassis_width / 2.0}" yaw="${pi / 2.0}" />
    <xacro:side_camera side="right" y="${-chassis_width / 2.0}" yaw="${-pi / 2.0}" />

    <!-- Horizontal range sensors (tiny depth cameras) for wall riding, at the
         chassis origin height so they look under the arms and camera housings.
         The sensor looks along its link +x; the housing sits just behind it. -->
    <xacro:macro name="range_sensor" params="name x y yaw">
        <link name="${name}_range_link">
            <xacro:box_inertia m="0.01" x="0.01" y="0.02" z="0.02" o_xyz="0 0 0" o_rpy="0 0 0" />

            <visual>
                <geometry>
                    <box size="0.01 0.02 0.02" />
                </geometry>
                <origin xyz="-0.006 0 0" rpy="0 0 0" />
                <material name="orange" />
            </visual>
        </link>

        <joint name="chassis_${name}_range_joint" type="fixed">
            <parent link="chassis" />
            <child link="${name}_range_link" />
            <origin xyz="${x} ${y} 0" rpy="0 0 ${yaw}" />
        </joint>
    </xacro:macro>

    <!-- Right range 0.06 m right of the centre, front range 0.16 m ahead of it -->
    <xacro:range_sensor name="right" x="0" y="-0.06" yaw="${-pi / 2.0}" />
    <xacro:range_sensor name="front" x="0.16" y="0" yaw="0" />
    <!-- Second drone only - left range, the mirror of the right one -->
    <xacro:if value="$(arg left_range)">
        <xacro:range_sensor name="left" x="0" y="0.06" yaw="${pi / 2.0}" />
    </xacro:if>

</robot>
