<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Sensor suite
           - front camera (clues)      /camera/image_raw       720x480, 5 Hz
           - down camera (navigation)  /down_camera/image_raw  320x240, 15 Hz
           - altimeter                 /altimeter              height relative to spawn
           - down range (depth cam)    /down_depth             height above the ground, 30 Hz
           - IMU                       /imu -->
    <xacro:property name="FOV" value="60" />
    <!-- Wide enough to see ~1.4 m of ground at a 0.3 m hover. Looking straight
         down at flat ground a wide FOV only changes the scale, not the shape -->
    <xacro:property name="DOWN_FOV" value="134" />

    <!-- Force controller - /cmd_vel (bridged to /model/my_robot/cmd_vel) is read as
         linear.x/y/z = forward/left/up force [N], angular.z = yaw rate [rad/s] -->
    <gazebo>
        <!-- Full path so Gazebo finds the plugin without relying on GZ_SIM_SYSTEM_PLUGIN_PATH -->
        <plugin filename="$(find drone_plugins)/../../lib/libDroneForceController.so"
            name="drone_plugins::DroneForceController">
            <link_name>chassis</link_name>
            <cmd_timeout>0.5</cmd_timeout>
            <max_force>20</max_force>
            <!-- 0 with wind on - the wind plugin already applies air drag
                 (1 N per m/s relative to the air). Use 1.0 if wind is off. -->
            <linear_drag>0.0</linear_drag>
        </plugin>
    </gazebo>

    <!-- Required for the IMU and altimeter sensors below to publish -->
    <gazebo>
        <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu">
        </plugin>
    </gazebo>

    <gazebo>
        <plugin filename="gz-sim-altimeter-system" name="gz::sim::systems::Altimeter">
        </plugin>
    </gazebo>

    <gazebo>
        <plugin filename="gz-sim-pose-publisher-system"
            name="gz::sim::systems::PosePublisher">
            <publish_model_pose>true</publish_model_pose>
            <publish_link_pose>false</publish_link_pose>
            <publish_sensor_pose>false</publish_sensor_pose>
            <publish_collision_pose>false</publish_collision_pose>
            <publish_visual_pose>false</publish_visual_pose>
            <update_frequency>50</update_frequency>
            <use_pose_vector_msg>false</use_pose_vector_msg>
        </plugin>
    </gazebo>

    <!-- Flying robot rule - wind must be enabled on the chassis -->
    <gazebo reference="chassis">
        <enable_wind>true</enable_wind>

        <sensor type="imu" name="imu_sensor">
            <always_on>1</always_on>
            <update_rate>100</update_rate>
            <visualize>false</visualize>
            <topic>imu</topic>
            <imu>
                <angular_velocity>
                    <x><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></x>
                    <y><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></y>
                    <z><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></z>
                </angular_velocity>
                <linear_acceleration>
                    <x><noise type="gaussian"><mean>0</mean><stddev>0.017</stddev></noise></x>
                    <y><noise type="gaussian"><mean>0</mean><stddev>0.017</stddev></noise></y>
                    <z><noise type="gaussian"><mean>0</mean><stddev>0.017</stddev></noise></z>
                </linear_acceleration>
            </imu>
        </sensor>

        <!-- 1D height relative to the spawn height (vertical_position) -->
        <sensor type="altimeter" name="altimeter_sensor">
            <always_on>1</always_on>
            <update_rate>30</update_rate>
            <visualize>false</visualize>
            <topic>altimeter</topic>
            <altimeter>
                <vertical_position>
                    <noise type="gaussian"><mean>0</mean><stddev>0.01</stddev></noise>
                </vertical_position>
                <vertical_velocity>
                    <noise type="gaussian"><mean>0</mean><stddev>0.01</stddev></noise>
                </vertical_velocity>
            </altimeter>
        </sensor>
    </gazebo>

    <!-- Navigation camera - low resolution, used only for road following.
         Image top = drone forward, image left = drone left. -->
    <gazebo reference="down_camera_link">
        <sensor type="camera" name="down_camera">
            <pose relative_to='down_camera_link'>0 0 0 0 0 0</pose>
            <camera>
                <horizontal_fov>${DOWN_FOV * pi / 180}</horizontal_fov>
                <image>
                    <width>320</width>
                    <height>240</height>
                </image>
                <clip>
                    <near>0.1</near>
                    <far>100</far>
                </clip>
                <!-- Custom camera rule - Gaussian noise, mean 0, stddev >= 0.007 -->
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.007</stddev>
                </noise>
            </camera>
            <always_on>1</always_on>
            <update_rate>15</update_rate>
            <visualize>true</visualize>
            <topic>down_camera/image_raw</topic>
        </sensor>
    </gazebo>

    <gazebo reference="camera_link">
        <sensor type="camera" name="front_camera">
            <pose relative_to='camera_link'>0 0 0 0 0 0</pose>
            <camera>
                <horizontal_fov>${FOV * pi / 180}</horizontal_fov>
                <image>
                    <width>720</width>
                    <height>480</height>
                </image>
                <clip>
                    <near>0.1</near>
                    <far>100</far>
                </clip>
                <!-- Custom camera rule - Gaussian noise, mean 0, stddev >= 0.007 -->
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.007</stddev>
                </noise>
            </camera>
            <always_on>1</always_on>
            <!-- Low rate - only needed when reading a clue board -->
            <update_rate>5</update_rate>
            <visualize>true</visualize>
            <topic>camera/image_raw</topic>
        </sensor>
    </gazebo>

    <!-- Downward range sensor - an 8x8 depth camera with a narrow view, pointing
         straight down. (A gpu_lidar was tried first but returns only its minimum
         range with the competition world's ogre render engine.) Noise and
         clipping follow the camera rules - stddev >= 0.007, clipping as provided. -->
    <gazebo reference="down_range_link">
        <sensor type="depth_camera" name="down_range">
            <pose relative_to='down_range_link'>0 0 0 0 0 0</pose>
            <topic>down_depth</topic>
            <update_rate>30</update_rate>
            <always_on>1</always_on>
            <visualize>false</visualize>
            <camera>
                <horizontal_fov>0.2</horizontal_fov>
                <image>
                    <width>8</width>
                    <height>8</height>
                    <format>R_FLOAT32</format>
                </image>
                <clip>
                    <near>0.1</near>
                    <far>100</far>
                </clip>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.007</stddev>
                </noise>
            </camera>
        </sensor>
    </gazebo>
</robot>
